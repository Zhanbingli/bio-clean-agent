# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & privacy
# Comma-separated origins for the web UI; set to production hostnames in real deployments.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API keys (set to enable authentication on web uploads/API)
WEB_API_KEY=replace-with-strong-key
JOB_API_KEY=replace-with-strong-key
# Use a strong random hex string: python -c "import secrets; print(secrets.token_hex(32))"
PHI_HASH_SALT=replace-with-random-hex
# Max upload size in megabytes enforced by the web layer
MAX_FILE_SIZE_MB=100
# Enable structured audit logging of PHI/PII handling
ENABLE_AUDIT_LOGGING=true

# Planner / LLM settings
# Set only when using the OpenAI planner backend
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG=
PLANNER_MODEL=openai
# Generation tuning
PLANNER_TEMPERATURE=0.1
PLANNER_TOP_P=0.9
PLANNER_MAX_NEW_TOKENS=768
