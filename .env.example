# Bio Clean Agent - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# CORS: Allowed origins for API access (comma-separated)
# Production: Use specific domains only
# Development: Can use localhost
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=100

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORGANIZATION=your_org_id_here

# LLM Generation Parameters
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=768

# ============================================================================
# DATA SECURITY
# ============================================================================

# Salt for PHI hashing (use a strong random string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHI_HASH_SALT=your_random_salt_here_change_in_production

# Enable audit logging for sensitive operations
ENABLE_AUDIT_LOGGING=true

# Audit log directory
AUDIT_LOG_DIR=./audit_logs

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Upload/Output Directories
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# DATABASE (Future Use)
# ============================================================================

# Uncomment and configure when implementing persistent storage
# DATABASE_URL=postgresql://user:password@localhost:5432/bio_clean_agent

# ============================================================================
# MONITORING & OBSERVABILITY (Future Use)
# ============================================================================

# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=your_connection_string_here
